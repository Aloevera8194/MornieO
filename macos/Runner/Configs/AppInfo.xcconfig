// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Mornye

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.zarz.mornye

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 zarz. All rights reserved.

// Code signing: ad hoc, unless scripts/setup_macos_signing.sh wrote a stable
// self-signed identity. A stable identity keeps keychain access across
// rebuilds and updates.
MORNYE_CODE_SIGN_IDENTITY = -
#include? "LocalSigning.xcconfig"
CODE_SIGN_IDENTITY = $(MORNYE_CODE_SIGN_IDENTITY)
// Manual signing would otherwise add the debugger entitlement to releases.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO
